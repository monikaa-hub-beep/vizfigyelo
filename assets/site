:root{--bg:#f4f8fb;--card:#fff;--tx:#12263a;--mu:#5d7083;--bd:#d9e3ec;--ac:#0b7fc7;--wa:#c2410c;--land:#e4eef5}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0e1a26;--card:#152433;--tx:#e6eef5;--mu:#93a7ba;--bd:#26394c;--ac:#4cb3f0;--wa:#fb923c;--land:#1b2f42}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.55 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
a{color:var(--ac)}
.w{max-width:1080px;margin:0 auto;padding:16px}
h1{font-size:1.6rem;margin:.2em 0}h2{font-size:1.15rem;margin:0 0 .5em}
.sub{color:var(--mu);margin:0 0 12px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:14px;margin-top:14px}
.grid{display:grid;grid-template-columns:1.2fr 1fr;gap:14px}.grid .card{margin-top:0}
@media(max-width:800px){.grid{grid-template-columns:1fr}}
.demo{background:color-mix(in srgb,var(--wa) 15%,transparent);border:1px solid var(--wa);border-radius:10px;padding:10px 12px;margin:12px 0;font-size:.9rem}
header.site{background:var(--card);border-bottom:1px solid var(--bd)}
.bar{display:flex;align-items:center;gap:18px;flex-wrap:wrap;padding-top:10px;padding-bottom:10px}
.brand{font-weight:700;font-size:1.15rem;text-decoration:none;color:var(--tx)}
nav{display:flex;gap:6px;flex-wrap:wrap}
nav a{padding:6px 12px;border-radius:99px;text-decoration:none;color:var(--tx)}
nav a[aria-current],nav a:hover{background:var(--ac);color:#fff}
#mb{display:none;margin-left:auto;font-size:1.3rem;background:none;border:1px solid var(--bd);border-radius:8px;color:var(--tx);padding:2px 10px}
@media(max-width:640px){#mb{display:block}nav{display:none;width:100%;flex-direction:column}nav.open{display:flex}}
footer.site{color:var(--mu);font-size:.85rem;margin-top:24px;border-top:1px solid var(--bd)}
svg{width:100%;height:auto;display:block}
.land{fill:var(--land);stroke:var(--mu);stroke-width:1.5}
.dot{cursor:pointer;stroke:var(--card);stroke-width:2}.dot:hover,.dot.sel{stroke:var(--tx)}
.lbl{font-size:11px;fill:var(--tx);pointer-events:none}
table{width:100%;border-collapse:collapse;font-size:.9rem}
th,td{text-align:left;padding:6px 6px;border-bottom:1px solid var(--bd)}th{color:var(--mu);font-weight:600}
td.n,th.n{text-align:right;font-variant-numeric:tabular-nums}
tr.r{cursor:pointer}tr.r:hover{background:var(--land)}
.sc{overflow-x:auto}
.tag{font-size:.75rem;padding:1px 7px;border-radius:99px;border:1px solid var(--bd);color:var(--mu)}
.note{color:var(--mu);font-size:.82rem}
.ctl{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:10px}
select,input,textarea{font:inherit;color:var(--tx);background:var(--bg);border:1px solid var(--bd);border-radius:8px;padding:8px 10px;width:100%}
.ctl select{width:auto}
label{display:block;margin:10px 0 4px;font-weight:600}
label.chk{display:flex;gap:8px;font-weight:400;align-items:flex-start}label.chk input{width:auto;margin-top:5px}
.btn{background:var(--ac);color:#fff;border:0;border-radius:8px;padding:9px 16px;font:inherit;cursor:pointer}
.btn.alt{background:transparent;color:var(--tx);border:1px solid var(--bd)}
.prose{max-width:760px}.prose p,.prose li{line-height:1.65}
.post{display:block;text-decoration:none;color:inherit}.post h2{margin:0}
#cb{position:fixed;left:12px;right:12px;bottom:12px;max-width:620px;margin:0 auto;z-index:50;box-shadow:0 6px 24px rgba(0,0,0,.25)}
#cb .row{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
